# Settings of the AIpiary server. make run-server copies this file to
# userdata/server/swai/server.env on its first run; in the docker image the
# file is read from /swai/server.env.
#
# The admin account is configured here rather than stored in the database.
# Both lines are printed by `make create-admin-pw`. ADMIN_EMAIL is the login
# name and ADMIN_PW the bcrypt hash of the password (not the password). The
# admin can create all other users from the profile page.
ADMIN_EMAIL=
ADMIN_PW=
# The public URL of this server, e.g., https://www.example.com. It is used for
# the links in emails, the sitemap (robots.txt and sitemap.xml), and the server
# URL in /scripts/run-worker.sh. If it is on a www subdomain, requests for the
# bare domain are redirected to it.
OWN_URL=
# Sending emails (account creation and password reset links). If OWN_URL,
# OWN_EMAIL, SMTP_HOST or SMTP_USER is empty, emails are printed to the server
# log instead of being sent. SMTP_PORT is the port of the SMTP server with
# STARTTLS; it must be a number (remove the line to use 587).
OWN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PW=
# Invite link of a Discord server. If set, it is shown on the profile page and
# in the account creation email.
DISCORD_URL=
# The image prefix the provider images were pushed to (PROVIDER_REGISTRY in
# system.env, e.g., "yourdockerhubuser"). /scripts/run-worker.sh tells
# volunteers to pull the worker images from there.
PROVIDER_REGISTRY=
# Where /scripts/run-worker.sh downloads the GGUF model from. The file name at
# the end of the URL must be the file name of model_path in
# deploy/graphs/graph_llama.json, the graph built into the worker image:
# Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf. The default downloads it from
# Hugging Face (see "Models" in the README for its license); point it at your
# own copy if you prefer, or leave it empty to have volunteers place the model
# file themselves.
MODEL_URL=https://huggingface.co/bartowski/Meta-Llama-3.1-8B-Instruct-GGUF/resolve/main/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
# Send CORS headers (Access-Control-Allow-Origin: *). Not needed when the
# client is served by this server or by `make run-ts` (it proxies the API).
CROSS_ORIGIN=false
# Where the accounts are kept: empty (the user store of the config file,
# Redis) or "postgres". With "postgres" the server connects with the PG*
# settings below and creates its tables on startup if they do not exist.
# Accounts are not copied between the stores. See "Keeping the accounts in
# Postgres" in the README.
USER_STORE=
# The Postgres connection (only read with USER_STORE=postgres). PGPORT
# defaults to 5432.
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
