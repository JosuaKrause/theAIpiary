# Settings of a provider (worker bee). make run-provider copies this file to
# userdata/provider/swai/provider.env on its first run; in the docker images
# the file is read from /swai/provider.env (run-worker.sh writes it).
#
# A worker token and the user it belongs to (the user's email address). Create
# the token on the profile page of the server.
AIPIARY_WORKER_TOKEN=
AIPIARY_USER=
# The URL of the AIpiary server.
AIPIARY_API_URL=http://localhost:8080/
# The provider appends a line DEVICE_ID=... on its first start. It names this
# machine in the worker list; keep it to keep the name.
