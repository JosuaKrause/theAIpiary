# The optional TLS reverse proxy of deploy/docker-compose.server.yml (compose
# profile "tls"). Caddy gets and renews the certificates from Let's Encrypt by
# itself; the domain has to point at this host and ports 80 and 443 have to be
# reachable from the internet.
#
# AIPIARY_DOMAIN is the site address, e.g. "chat.example.com". If OWN_URL in
# server.env is on a www subdomain, list both names,
# "www.example.com, example.com"; the server redirects the bare domain to www.
{
	servers {
		# HTTP/3 needs UDP port 443, which the compose file does not publish
		protocols h1 h2
	}
}

{$AIPIARY_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080
}
