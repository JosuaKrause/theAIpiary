#
# Settings of deploy/docker-compose.server.yml. On the server host, copy this
# file to .env in the directory that holds the compose file (docker compose
# reads it from there) and fill in the values.
#
# The data directory on the host. It holds everything that has to survive an
# upgrade: swai/server.env (the server's settings, see server.env.sample),
# session/ (chat blobs and cache), rserver/ (the Redis snapshot) and caddy/
# (the certificates, only with the tls profile).
AIPIARY_DATA=/srv/aipiary/data
# The image prefix the server images were pushed to, the same value as in
# system.env, without a trailing slash. Leave it empty for images that were
# built on this host.
SERVER_REGISTRY=
# The image tags. make build-server prints both and writes them to
# deploy/default.server.env.
AIPIARY_VERSION=
AIPIARY_REDIS_VERSION=
# The optional TLS reverse proxy: uncomment both lines to start Caddy on ports
# 80 and 443 with a certificate for AIPIARY_DOMAIN (see deploy/Caddyfile).
# COMPOSE_PROFILES=tls
# AIPIARY_DOMAIN=chat.example.com
