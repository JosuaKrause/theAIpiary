{
  "client_pool": {
    "name": "redis",
    "cfg": {
      "host": "localhost",
      "port": 6381,
      "passwd": "",
      "prefix": "swai",
      "path": "../userdata/provider/rmain"
    }
  },
  "data_store": {
    "name": "redis",
    "cfg": {
      "host": "localhost",
      "port": 6382,
      "passwd": "",
      "prefix": "swai",
      "path": "../userdata/provider/rbody"
    },
    "mode": "size"
  },
  "executor_manager": {
    "name": "redis",
    "batch_size": 1,
    "sleep_on_idle": 60.0,
    "reclaim_sleep": 600.0,
    "heartbeat_time": 30.0,
    "cfg": {
      "host": "localhost",
      "port": 6381,
      "passwd": "",
      "prefix": "heartbeat",
      "path": "../userdata/provider/rmain"
    }
  },
  "queue_pool": {
    "name": "redis",
    "cfg": {
      "host": "localhost",
      "port": 6383,
      "passwd": "",
      "prefix": "swai",
      "path": "../userdata/provider/rdata"
    },
    "check_assertions": false
  },
  "graph_cache": {
    "name": "redis",
    "cfg": {
      "host": "localhost",
      "port": 6384,
      "passwd": "",
      "prefix": "swai",
      "path": "../userdata/provider/rcache"
    },
    "use_defer": true
  },
  "strategy": {
    "node": {
      "name": "dedicated"
    },
    "queue": {
      "name": "simple"
    }
  },
  "readonly_access": {
    "name": "ram",
    "scratch": "../userdata/provider/smind_cache/"
  },
  "sessions": {
    "name": "swai_provider.smind.remote_session",
    "cache_path": "../userdata/provider/smind/cache/",
    "is_shared": false
  },
  "logger": {
    "listeners": [
      {
        "name": "stdout",
        "show_debug": true
      }
    ],
    "disable_events": ["measure", "debug"]
  }
}
